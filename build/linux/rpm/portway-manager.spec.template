Name:           portway-manager
Version:        {{.Info.ProductVersion}}
Release:        1%{?dist}
Summary:        {{.Info.Comments}}

License:        MIT
Packager:       {{.Author.Name}}

Requires:       {{.libwebkit2gtk.PackageName}}, gtk3
BuildArch:      x86_64

%description
{{.Info.Comments}}

%install
mkdir -p %{buildroot}%{_bindir}
mkdir -p %{buildroot}%{_datadir}/applications
mkdir -p %{buildroot}%{_datadir}/icons/hicolor/512x512/apps

install -m 0755 %{_sourcedir}/portway-manager %{buildroot}%{_bindir}/portway-manager
install -m 0644 %{_sourcedir}/portway-manager.desktop %{buildroot}%{_datadir}/applications/portway-manager.desktop
install -m 0644 %{_sourcedir}/portway-manager.png %{buildroot}%{_datadir}/icons/hicolor/512x512/apps/portway-manager.png

%files
%{_bindir}/portway-manager
%{_datadir}/applications/portway-manager.desktop
%{_datadir}/icons/hicolor/512x512/apps/portway-manager.png

%post
update-desktop-database &> /dev/null || :
gtk-update-icon-cache %{_datadir}/icons/hicolor &> /dev/null || :

%postun
update-desktop-database &> /dev/null || :
gtk-update-icon-cache %{_datadir}/icons/hicolor &> /dev/null || :

%changelog
* {{.ChangelogDate}} {{.Author.Name}} - {{.Info.ProductVersion}}-1
- Release {{.Info.ProductVersion}}
